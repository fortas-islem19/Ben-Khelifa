# Optional: copy this file to `.env` to override the values set in src/config/site.js.

# Google Apps Script Web App URL (see integrations/google-sheets/README.md)
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Meta (Facebook) Pixel ID — leave empty to disable tracking
VITE_META_PIXEL_ID=

# WhatsApp number in international format, digits only (e.g. 213555123456)
VITE_WHATSAPP_NUMBER=
